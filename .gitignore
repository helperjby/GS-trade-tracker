# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/

# 빌드 산출물 — exe 는 릴리스 때 deploy/ 로 복사한다
build/
build_temp/
dist/
*.spec

# 런타임 산출물 (로그·수집 창은 원장 폴더에 남는다 — 레포에 넣지 않는다)
log/
wordinput_review/
*.jsonl
*.pcapng
# 빌드 시 주입되는 허브 기본 주소 — 공개 레포 소스에 tailnet 주소를 두지 않는다(tools/gen_build_config.py)
src/yuktracker/_build_config.py

# 클라 리소스에서 추출한 아이템 표(tools/dump_item_names.py --out) — 재배포하지 않는다, 캐시는 %APPDATA%\YukTracker
item_names*.json

# OS
Thumbs.db
desktop.ini

# 허브(hub/) 런타임 — 시크릿·DB 는 레포에 넣지 않는다.
# 상대 db_path·HUB_DATA_DIR 로 DB 가 hub/data/ 밖(레포 루트 등)에 생길 수 있어 넓게 막는다.
hub/config.json
hub/data/
/data/
.env
*.db
*.db-wal
*.db-shm
